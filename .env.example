# Select active providers (must exist in config/providers.yaml)
ACTIVE_LLM_PROVIDER=openai
ACTIVE_EMBEDDING_PROVIDER=openai
ACTIVE_VECTOR_DB_PROVIDER=chroma

# LLM keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional provider endpoints
OLLAMA_BASE_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Optional override to load a different config file
# APP_CONFIG_PATH=config/providers.yaml
